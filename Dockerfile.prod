# Build Stage — sama seperti Dockerfile dev, menghasilkan bundle statis
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci || npm install

COPY . .

# Build argument untuk URL API SSO (tertanam saat build ke dalam bundle JS
# Vite — ganti alamat = wajib build ulang image, tidak bisa diubah lewat env
# runtime).
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Production Stage — nginx NON-ROOT (image resmi nginxinc, bukan nginx:alpine
# biasa yang start sebagai root). Sudah berjalan sebagai user 'nginx' (uid
# 101) bawaan image, mendengarkan di port 8080, dan /var/log/nginx sudah
# di-symlink ke stdout/stderr sejak awal (log tertangkap `docker logs`,
# tidak perlu volume/izin tulis file tambahan).
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
